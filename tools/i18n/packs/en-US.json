{
  "tag": "en-US",
  "name": "English (US)",
  "script": "Latn",
  "version": "2026.11.18",
  "files": {
    "lexicon": {
      "path": "dogboard/en.lexicon.tsv",
      "budget_bytes": 6000000
    },
    "bigrams": {
      "path": "dogboard/en.bigrams.tsv",
      "budget_bytes": 4000000
    },
    "ngrams": {
      "path": "dogboard/en.ngrams.bin",
      "optional": true,
      "budget_bytes": 64000000
    },
    "charlm": {
      "path": "dogboard/en.charlm.bin",
      "budget_bytes": 4000000
    },
    "abbreviations": {
      "path": "dogboard/en.abbreviations.txt"
    },
    "nosuggest": {
      "path": "dogboard/en.nosuggest.txt"
    },
    "misspellings": {
      "path": "dogboard/en.misspellings.txt"
    },
    "emoji": {
      "path": "dogboard/en.emoji.tsv"
    },
    "emoji_tones": {
      "path": "dogboard/en.emoji-tones.tsv"
    },
    "lm_model": {
      "path": "dogboard/lm/v3.tflite",
      "optional": true,
      "budget_bytes": 32000000
    },
    "lm_pieces": {
      "path": "dogboard/lm/v3.pieces.tsv",
      "optional": true
    },
    "swipe_qwerty": {
      "path": "dogboard/swipe/en-qwerty.tflite",
      "optional": true,
      "budget_bytes": 6000000
    },
    "rules": {
      "path": "dogboard/packs/en-US/rules.json"
    }
  },
  "sources": [
    {
      "name": "SCOWL 2020.12.07",
      "licence": "SCOWL copyright notice (licenses/SCOWL-Copyright.txt)",
      "for": [
        "lexicon"
      ],
      "url": "http://wordlist.aspell.net/"
    },
    {
      "name": "wordfreq 3.1.1",
      "licence": "CC BY-SA 4.0",
      "for": [
        "lexicon",
        "emoji"
      ],
      "url": "https://github.com/rspeer/wordfreq"
    },
    {
      "name": "Wikidata",
      "licence": "CC0",
      "for": [
        "lexicon"
      ],
      "url": "https://www.wikidata.org"
    },
    {
      "name": "US Census name lists (1990 first names, 2010 surnames)",
      "licence": "public domain",
      "for": [
        "lexicon"
      ]
    },
    {
      "name": "GeoNames",
      "licence": "CC BY 4.0",
      "for": [
        "lexicon"
      ],
      "url": "https://www.geonames.org"
    },
    {
      "name": "Wikipedia common misspellings",
      "licence": "CC BY-SA 4.0",
      "for": [
        "lexicon",
        "misspellings"
      ]
    },
    {
      "name": "Tatoeba",
      "licence": "CC BY 2.0 FR",
      "for": [
        "bigrams"
      ],
      "url": "https://tatoeba.org"
    },
    {
      "name": "FineWeb sample-10BT",
      "licence": "ODC-By 1.0 (Common Crawl terms apply)",
      "for": [
        "charlm",
        "ngrams",
        "lm_model"
      ],
      "url": "https://huggingface.co/datasets/HuggingFaceFW/fineweb"
    },
    {
      "name": "Unicode CLDR",
      "licence": "Unicode License v3",
      "for": [
        "abbreviations",
        "emoji",
        "emoji_tones"
      ],
      "url": "https://github.com/unicode-org/cldr"
    },
    {
      "name": "LDNOOBW (English)",
      "licence": "CC BY 4.0",
      "for": [
        "nosuggest"
      ],
      "url": "https://github.com/LDNOOBW"
    },
    {
      "name": "Neural model training text (see ATTRIBUTION.txt: Webis TLDR-17, SODA, WildChat-1M, Synthetic-Persona-Chat, Leipzig Corpora, Common Voice, Ubuntu IRC, SmolLM2-written chats)",
      "licence": "various (ATTRIBUTION.txt)",
      "for": [
        "lm_model",
        "lm_pieces"
      ]
    },
    {
      "name": "FUTO swipe dataset",
      "licence": "MIT (licenses/FUTO-swipe-dataset-MIT.txt)",
      "for": [
        "swipe_qwerty"
      ],
      "url": "https://huggingface.co/datasets/futo-org/swipe.futo.org"
    },
    {
      "name": "DogBoard project (language rules)",
      "licence": "same as the app",
      "for": [
        "rules"
      ]
    }
  ],
  "build": [
    {
      "stage": "lexicon",
      "run": [
        "python3",
        "tools/data/build_lexicon.py",
        "--data",
        "${DATA}",
        "--casing",
        "${DATA}/casing/casing.tsv",
        "--out",
        "${ASSETS}/dogboard/en.lexicon.tsv"
      ],
      "inputs": [
        "tools/data/build_lexicon.py",
        "${DATA}/scowl/scowl-2020.12.07",
        "${DATA}/wordfreq/whl/wordfreq/data/large_en.msgpack.gz",
        "${DATA}/wikipedia/common_misspellings.txt"
      ],
      "outputs": [
        "${ASSETS}/dogboard/en.lexicon.tsv"
      ]
    },
    {
      "stage": "misspellings",
      "run": [
        "python3",
        "tools/data/build_misspellings.py",
        "${DATA}/wikipedia/common_misspellings.txt",
        "${ASSETS}/dogboard/en.lexicon.tsv",
        "${ASSETS}/dogboard/en.misspellings.txt"
      ],
      "inputs": [
        "tools/data/build_misspellings.py",
        "${ASSETS}/dogboard/en.lexicon.tsv"
      ],
      "outputs": [
        "${ASSETS}/dogboard/en.misspellings.txt"
      ]
    },
    {
      "stage": "nosuggest",
      "run": [
        "python3",
        "tools/data/build_nosuggest.py",
        "${REPO}/../data/ldnoobw/en"
      ],
      "inputs": [
        "tools/data/build_nosuggest.py",
        "${ASSETS}/dogboard/en.lexicon.tsv"
      ],
      "outputs": [
        "${ASSETS}/dogboard/en.nosuggest.txt"
      ]
    },
    {
      "stage": "bigrams",
      "run": [
        "python3",
        "tools/data/bigrams_from_tatoeba.py",
        "${DATA}/tatoeba/eng_sentences.tsv"
      ],
      "inputs": [
        "tools/data/bigrams_from_tatoeba.py",
        "${ASSETS}/dogboard/en.lexicon.tsv"
      ],
      "outputs": [
        "${ASSETS}/dogboard/en.bigrams.tsv"
      ]
    },
    {
      "stage": "abbreviations",
      "run": [
        "python3",
        "tools/data/build_abbreviations.py",
        "${DATA}/cldr/segments-en.xml"
      ],
      "inputs": [
        "tools/data/build_abbreviations.py",
        "${DATA}/cldr/segments-en.xml"
      ],
      "outputs": [
        "${ASSETS}/dogboard/en.abbreviations.txt"
      ]
    },
    {
      "stage": "emoji",
      "run": [
        "python3",
        "tools/data/build_emoji_keywords.py",
        "${DATA}/cldr/annotations-en.xml",
        "${DATA}/wordfreq/whl/wordfreq/data/large_en.msgpack.gz",
        "${DATA}/cldr/annotationsDerived-en.xml"
      ],
      "inputs": [
        "tools/data/build_emoji_keywords.py",
        "${DATA}/cldr/annotations-en.xml",
        "${DATA}/cldr/annotationsDerived-en.xml"
      ],
      "outputs": [
        "${ASSETS}/dogboard/en.emoji.tsv",
        "${ASSETS}/dogboard/en.emoji-tones.tsv"
      ]
    },
    {
      "stage": "charlm",
      "manual": true,
      "run": [
        "sh",
        "-c",
        "echo 'tools/data/count_unigrams.py (FineWeb) -> tools/data/build_charlm.py UNIGRAMS ${ASSETS}/dogboard/en.lexicon.tsv ${ASSETS}/dogboard/en.charlm.tsv --misspellings ${DATA}/wikipedia/common_misspellings.txt -> binary ${ASSETS}/dogboard/en.charlm.bin'"
      ],
      "inputs": [],
      "outputs": [
        "${ASSETS}/dogboard/en.charlm.bin"
      ]
    },
    {
      "stage": "ngrams",
      "manual": true,
      "run": [
        "sh",
        "-c",
        "echo 'FineWeb sentences (tools/data/fineweb_sentences.py) -> KenLM lmplz -o 3 -> tools/data/arpa_to_dogboard.py MODEL.arpa ${ASSETS}/dogboard/en.ngrams.bin'"
      ],
      "inputs": [],
      "outputs": [
        "${ASSETS}/dogboard/en.ngrams.bin"
      ]
    },
    {
      "stage": "neural_lm",
      "manual": true,
      "run": [
        "sh",
        "-c",
        "echo 'tools/lm: train (wandb dogboard-llm), then tools/lm/export_kv2.py CKPT OUT 64 -> ${ASSETS}/dogboard/lm/v3.tflite'"
      ],
      "inputs": [],
      "outputs": [
        "${ASSETS}/dogboard/lm/v3.tflite"
      ]
    },
    {
      "stage": "swipe",
      "manual": true,
      "run": [
        "sh",
        "-c",
        "echo 'tools/swipe: train (wandb dogboard-swipe), export_tflite.py -> ${ASSETS}/dogboard/swipe/en-qwerty.tflite'"
      ],
      "inputs": [],
      "outputs": [
        "${ASSETS}/dogboard/swipe/en-qwerty.tflite"
      ]
    }
  ],
  "validate": [
    {
      "name": "autocorrect eval",
      "run": [
        "./gradlew",
        "--no-daemon",
        "--max-workers=2",
        "-q",
        ":app:testDebugUnitTest",
        "--tests",
        "io.github.sillypuppyy.dogboard.engine.EngineEvalTest",
        "--rerun"
      ],
      "env": {
        "DOGBOARD_EVAL": "1"
      }
    },
    {
      "name": "context eval",
      "run": [
        "./gradlew",
        "--no-daemon",
        "--max-workers=2",
        "-q",
        ":app:testDebugUnitTest",
        "--tests",
        "io.github.sillypuppyy.dogboard.engine.EngineContextEvalTest",
        "--rerun"
      ],
      "env": {
        "DOGBOARD_EVAL": "1",
        "DOGBOARD_NGRAMS": "${ASSETS}/dogboard/en.ngrams.bin"
      }
    }
  ]
}
